{
  "name": "@zsuite/ui",
  "version": "1.0.0",
  "description": "Svelte 5 UI kit: shadcn-svelte components with right-to-left support, design tokens and the runtime for .zth looks.",
  "license": "Apache-2.0",
  "homepage": "https://zal-analytics.github.io/zsuite/",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZAL-Analytics/zsuite.git",
    "directory": "packages/ui"
  },
  "files": [
    "src"
  ],
  "exports": {
    "./tokens.css": {
      "style": "./src/tokens.css",
      "default": "./src/tokens.css"
    },
    "./utils": "./src/utils.ts",
    "./direction": "./src/direction.svelte.ts",
    "./look": "./src/look.ts",
    "./i18n": "./src/i18n.svelte.ts",
    "./*": {
      "svelte": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    }
  },
  "dependencies": {
    "cn": "^0.4.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@lucide/svelte": ">=1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bits-ui": "^2",
    "paneforge": "^1",
    "svelte": "^5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/markdown": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3"
  }
}
