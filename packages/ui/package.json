{
  "name": "@zsuite/ui",
  "version": "0.1.0",
  "description": "Svelte 5 UI kit: shadcn-svelte components with right-to-left support, design tokens and the runtime for .zth looks.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZAL-Analytics/zsuite.git",
    "directory": "packages/ui"
  },
  "files": [
    "src"
  ],
  "exports": {
    "./tokens.css": {
      "style": "./src/tokens.css",
      "default": "./src/tokens.css"
    },
    "./utils": "./src/utils.ts",
    "./direction": "./src/direction.svelte.ts",
    "./look": "./src/look.ts",
    "./*": {
      "svelte": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    }
  },
  "dependencies": {
    "cn": "^0.4.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@lucide/svelte": ">=1",
    "bits-ui": "^2",
    "paneforge": "^1",
    "svelte": "^5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1"
  }
}
